# Postgres credentials for the 3b market/evaluation database.
# Copy to db/.env and fill in — bin/db_up.sh generates a strong password automatically if the file
# does not exist yet. PLACEHOLDERS ONLY in this file; db/.env is gitignored and created mode 0600.
#
# There is no host PORT anywhere: the database publishes none (internal-only network, ADR-001).
# Reach it with bin/db_psql.sh or from a container attached to rh-internal.
#
# db/.env is parsed as DATA (docker compose --env-file / grep), never `source`d as shell — but
# keep passwords to URL-safe characters anyway ([A-Za-z0-9_-], what db_up.sh generates); exotic
# characters in credentials buy nothing and eventually meet a parser that disagrees.

POSTGRES_USER=rh
POSTGRES_DB=robinhood_agentic

# Generated by bin/db_up.sh; never a real value in this example file.
#
# ROTATION — two steps, BOTH required, in this order:
#   1. bin/db_psql.sh -c '\password rh'   <- changes the database. \password prompts, hashes
#      client-side, and sends ALTER ROLE — the new secret never appears in argv or server logs.
#   2. edit the POSTGRES_PASSWORD line in db/.env to match              <- changes what clients send
# POSTGRES_PASSWORD is consumed only by initdb on a brand-new volume; editing this file and
# recreating the container against the existing volume rotates NOTHING — the old password stays
# valid in pg_authid and the container still reports healthy. No container restart is needed for a
# real rotation; only clients holding the old value care.
POSTGRES_PASSWORD=replace-me

# Resource ceilings for the container. Postgres will happily use everything you give it; these keep
# it from starving the rest of the box, which also runs 9b Korean Master.
DB_MEM_LIMIT=2g
DB_CPU_LIMIT=2.0

# shared_buffers / work_mem tuning for the bulk minute-bar loads. Conservative defaults; raise
# work_mem only for the loader session, not globally — 300M-row sorts will otherwise exhaust RAM.
DB_SHARED_BUFFERS=512MB
DB_WORK_MEM=16MB
