# Backend configuration. Copy to backend/.env and fill in.
# bin/up.sh exports these into the compose environment so the backend container receives them.

# Required only for the live debate/pipeline engine (jury runs real Anthropic API calls).
# The account/scan pages work without it.
ANTHROPIC_API_KEY=

# Financial Modeling Prep — the fundamentals/price provider that replaces Bloomberg.
# Free "Basic" tier is 250 calls/DAY, so the provider caches to Postgres and enforces a hard daily
# budget; development and tests run off fixtures and never touch the live API.
FMP_API_KEY=
# Daily call ceiling. Keep at the tier's limit; the provider stops (loudly) when it is reached
# rather than silently degrading. Basic=250/day. Paid tiers are per-MINUTE, so raise this well past
# the daily figure and rely on the per-minute limiter instead.
FMP_DAILY_CALL_BUDGET=250

# Model selection (optional — sensible defaults). Cheap jurors, stronger synthesis.
JURY_MODEL=claude-haiku-4-5
SYNTH_MODEL=claude-sonnet-4-6

# CORS origins for the browser (comma-separated explicit origins). Leave empty for local dev: the
# backend already allows localhost/127.0.0.1 on any port via its built-in regex. Set explicit origins
# (e.g. https://dash.example.com) for a shared/remote deploy. Do NOT use "*" — this fronts a live
# brokerage snapshot, an API key, and a side-effecting refresh endpoint.
CORS_ORIGINS=

# --- Transactional email (auth verification + security notices) -----------------------------
# SMTP relay for outbound mail, variable names mirroring 9b Korean Master's. In this deployment the
# relay is Proton Mail Bridge running on the docker HOST, reached from the backend container as
# host.docker.internal:1025 (the compose files add the extra_hosts mapping for it).
#
# LEAVE SMTP_HOST EMPTY in dev and CI: an unset host selects the log-only mock transport, which
# logs each message (verification link included) and sends nothing. That is deliberate — no Bridge
# is needed to develop or test, and CI can never send real mail.
SMTP_HOST=
SMTP_PORT=1025
# Bridge account credentials (from the Proton Mail Bridge UI). Secrets — real values live only in
# backend/.env, which is gitignored.
SMTP_USER=
SMTP_PASS=
# Verified sender identity. Proton rejects From addresses the account does not own; this one is
# confirmed working by live self-send. Leave as-is unless the sender identity itself changes.
SMTP_FROM=ww.notifications@jaredstudio.com
# TLS certificate verification for the STARTTLS hop. Default (true) verifies against the system
# trust store. Proton Mail Bridge presents a SELF-SIGNED certificate on the loopback/host-gateway
# hop, so chain validation cannot succeed against it — set false for the Bridge, and ONLY for the
# Bridge. The session is still TLS-encrypted either way; only certificate validation is skipped,
# and only via this explicit opt-out (never silently in code).
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Public origin of the dashboard, used to build absolute links in emails (e.g. the verification
# link). Prod: https://ww.jaredstudio.com. Dev default (unset) is http://localhost:3000, where the
# mock transport logs the link instead of sending it.
PUBLIC_ORIGIN=

# --- Database (rh-db over the rh-internal network) -------------------------------------------
# Two DSNs, two roles, two pools — docs/AUTH_THREAT_MODEL.md §8. DATABASE_URL connects as rh_app
# (everything except auth; migration 012 REVOKEs the auth tables from it entirely, so no non-auth
# query can ever read password hashes, TOTP secrets, or recovery-code hashes). AUTH_DATABASE_URL
# connects as rh_auth (auth flows only; column-level grants, no market-data access). Never point
# both at the same role — the split is the defense.
#
# Both may be LEFT EMPTY: no database is a first-class, supported state — the dashboard serves
# and history/evaluation features report themselves offline (backend/app/db/config.py).
#
# BOTH ROLES SHIP PASSWORDLESS from their migrations (001 creates rh_app, 012 creates rh_auth)
# and cannot authenticate over the network (scram-sha-256) until an operator sets passwords.
# One-time setup, run on the host (passwords never cross the host command line if you paste into
# the interactive shell instead of -c):
#
#   bin/db_psql.sh -c "ALTER ROLE rh_app  WITH PASSWORD '<generated secret 1>'"
#   bin/db_psql.sh -c "ALTER ROLE rh_auth WITH PASSWORD '<generated secret 2>'"
#
# Generate each secret with:  openssl rand -hex 24   (hex → safe inside a URL, no escaping).
# Host is the rh-db container name; port is Postgres' in-container 5432 (ADR-001: no host port).
DATABASE_URL=postgresql://rh_app:CHANGE_ME@rh-db:5432/robinhood_agentic
AUTH_DATABASE_URL=postgresql://rh_auth:CHANGE_ME@rh-db:5432/robinhood_agentic

# Encryption key for TOTP secrets at rest (docs/AUTH_THREAT_MODEL.md §7): base64 of EXACTLY
# 32 bytes (AES-256-GCM). Generate with:
#
#   openssl rand -base64 32
#
# This key must NEVER appear in rh-db (any table, any migration), the repo, an image layer, a
# compose file, a CI variable store, or a log line — it lives ONLY here in backend/.env (mode
# 0600), injected into the backend container as an environment variable. Back it up in a password
# manager: if the key is LOST, every stored TOTP secret is undecryptable and both operators must
# re-enroll; if it LEAKS, rotation is re-enrollment with fresh secrets, not re-encryption (§7).
TOTP_SECRET_ENC_KEY=

# The brokerage account the agent reads. Required by bin/morning_scan.sh, bin/refresh_once.sh and
# bin/refresh_daemon.sh, which render it into the MCP prompt at run time.
#
# Deliberately NOT stored in the repository. It is an identifier rather than a credential — it
# cannot move money by itself — but it is a real account number, this repo is shared, and the
# account is expected to change. Keeping it in config means swapping accounts is a one-line edit
# instead of a search across scripts, prompts and logs.
AGENTIC_ACCOUNT_NUMBER=

# --- Alpaca — the ACCOUNT OF RECORD for positions, cash and cost basis -----------------------
# FMP knows what companies are worth; only the broker knows what you own. When both credentials
# below are set, /api/account reads Alpaca live and the volume-mounted account_snapshot.json is
# ignored. With them unset, the file is used exactly as before — this is not a forced migration.
#
# Generate a PAPER key pair at alpaca.markets (Regenerate shows the secret ONCE; the key id alone
# is all the dashboard will ever display back to you).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# The ONE line separating paper from live. Explicit rather than inferred from the key's prefix,
# because the inferred version fails in the worst direction. Either form works — the dashboard
# shows the endpoint with a /v2 suffix and the client normalises it:
#   https://paper-api.alpaca.markets      https://paper-api.alpaca.markets/v2
# Live is https://api.alpaca.markets — changing this is the entire paper-to-live cutover.
ALPACA_BASE_URL=https://paper-api.alpaca.markets
