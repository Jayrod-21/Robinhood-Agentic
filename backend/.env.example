# Backend configuration. Copy to backend/.env and fill in.
# bin/up.sh exports these into the compose environment so the backend container receives them.

# Required only for the live debate/pipeline engine (jury runs real Anthropic API calls).
# The account/scan pages work without it.
ANTHROPIC_API_KEY=

# Financial Modeling Prep — the fundamentals/price provider that replaces Bloomberg.
# Free "Basic" tier is 250 calls/DAY, so the provider caches to Postgres and enforces a hard daily
# budget; development and tests run off fixtures and never touch the live API.
FMP_API_KEY=
# Daily call ceiling. Keep at the tier's limit; the provider stops (loudly) when it is reached
# rather than silently degrading. Basic=250/day. Paid tiers are per-MINUTE, so raise this well past
# the daily figure and rely on the per-minute limiter instead.
FMP_DAILY_CALL_BUDGET=250

# Model selection (optional — sensible defaults). Cheap jurors, stronger synthesis.
JURY_MODEL=claude-haiku-4-5
SYNTH_MODEL=claude-sonnet-4-6

# CORS origins for the browser (comma-separated explicit origins). Leave empty for local dev: the
# backend already allows localhost/127.0.0.1 on any port via its built-in regex. Set explicit origins
# (e.g. https://dash.example.com) for a shared/remote deploy. Do NOT use "*" — this fronts a live
# brokerage snapshot, an API key, and a side-effecting refresh endpoint.
CORS_ORIGINS=

# The brokerage account the agent reads. Required by bin/morning_scan.sh, bin/refresh_once.sh and
# bin/refresh_daemon.sh, which render it into the MCP prompt at run time.
#
# Deliberately NOT stored in the repository. It is an identifier rather than a credential — it
# cannot move money by itself — but it is a real account number, this repo is shared, and the
# account is expected to change. Keeping it in config means swapping accounts is a one-line edit
# instead of a search across scripts, prompts and logs.
AGENTIC_ACCOUNT_NUMBER=
