# Production stack config (copy to deploy/.env). Loaded by docker-compose.prod.yml.

# HTTP basic-auth shown by Caddy in front of the dashboard (it surfaces a live account).
DASH_USER=admin
# bcrypt hash of your password — generate with:
#   docker run --rm caddy caddy hash-password --plaintext 'your-strong-password'
DASH_PASSWORD_HASH=

# Local-only port cloudflared connects to (Caddy publishes here on 127.0.0.1).
DASH_PORT=8088
