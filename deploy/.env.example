# Production stack config (copy to deploy/.env, then `chmod 600 deploy/.env`).
# Loaded by docker-compose.prod.yml.

# HTTP basic-auth shown by Caddy in front of the dashboard (it surfaces a live account).
# Pick a NON-OBVIOUS username — this file used to ship `admin`, which hands an online-guessing
# attacker half the credential for free (finding F11, issue #17).
DASH_USER=
# bcrypt hash of your password — generate with:
#   docker run --rm caddy caddy hash-password --plaintext 'your-strong-password'
DASH_PASSWORD_HASH=

# Local-only port cloudflared connects to (Caddy publishes here on 127.0.0.1).
# M hosts several live stacks — verify the port is actually free before choosing it:
#   ss -ltn "sport = :8088"
DASH_PORT=8088
